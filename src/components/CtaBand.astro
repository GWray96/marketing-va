---
/**
 * Final CTA band (homepage block 13 / every money page's closing ask).
 * Same direct CTA the visitor has already seen 3–4×; risk reversal restated
 * one line below the button (playbook block 10 + 13).
 */
import { SITE, CTA } from '../config';

interface Props {
  heading?: string;
  sub?: string;
  loc?: string;
}

const {
  heading = 'One person. Your whole marketing function. Handled.',
  sub = `Free ${SITE.booking.callLength} intro call. ${SITE.booking.promise}`,
  loc = 'final',
} = Astro.props;
---

<section class="cta-band">
  <div class="wrap cta-inner">
    <h2>{heading}</h2>
    <p class="cta-sub">{sub}</p>
    <a href={SITE.booking.url} class="btn btn-on-copper" data-event="cta_click" data-event-loc={loc}>
      {CTA.direct}
    </a>
    <p class="cta-guarantee">Unlimited revisions on every piece of work · rolling monthly, no long contract</p>
  </div>
</section>

<style>
  .cta-band {
    background: var(--copper-deep);
    padding-block: clamp(56px, 8vw, 96px);
    margin-top: var(--gap-section);
  }

  .cta-inner {
    text-align: center;
    max-width: 760px;
  }

  .cta-band h2 {
    color: var(--white);
    font-size: clamp(1.8rem, 3.6vw, 2.6rem);
  }

  .cta-sub {
    color: var(--tint);
    font-size: 1.1rem;
    margin-bottom: 28px;
  }

  .cta-guarantee {
    color: var(--tint);
    font-size: 0.88rem;
    margin: 16px 0 0;
  }
</style>
