---
/**
 * FAQ accordion + FAQPage schema in one. Questions phrased the way buyers ask
 * (AEO); answers open with a direct ~40-word response.
 */
import Schema from './Schema.astro';
import { faqPage } from '../lib/schema';

interface Props {
  faqs: ReadonlyArray<{ q: string; a: string }>;
  heading?: string;
  eyebrow?: string;
}

const { faqs, heading = 'Questions founders actually ask', eyebrow = 'FAQ' } = Astro.props;
---

<section class="section" aria-label="Frequently asked questions">
  <div class="wrap faq-wrap">
    <p class="eyebrow">{eyebrow}</p>
    <h2>{heading}</h2>
    <div class="faq-list">
      {faqs.map((f) => (
        <details class="faq">
          <summary>{f.q}</summary>
          <div class="faq-a"><p>{f.a}</p></div>
        </details>
      ))}
    </div>
  </div>
</section>

<Schema schema={faqPage(faqs)} />

<style>
  .faq-wrap {
    max-width: 820px;
  }

  .faq-list {
    margin-top: 28px;
  }
</style>
