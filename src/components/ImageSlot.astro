---
/**
 * INTEGRITY: a clearly-labelled slot for a real photo the founder must supply
 * ([TODO-HUMAN]: headshot, working shots). Never filled with stock or AI faces.
 * Keeps explicit aspect-ratio so swapping the real image cannot shift layout (CLS).
 */
interface Props {
  label: string;
  ratio?: string;
  class?: string;
}

const { label, ratio = '4 / 5', class: className = '' } = Astro.props;
---

<div class={`img-slot ${className}`} style={`aspect-ratio: ${ratio};`} role="img" aria-label={`Placeholder for ${label}`}>
  <span class="img-slot-tag">[{label} — supply photo]</span>
</div>

<style>
  .img-slot {
    width: 100%;
    background:
      radial-gradient(ellipse at 30% 25%, var(--tint), transparent 60%),
      var(--surface);
    border: 2px dashed var(--stone);
    border-radius: var(--radius-lg);
    display: grid;
    place-items: center;
  }

  .img-slot-tag {
    font-size: 0.85rem;
    color: var(--stone);
    background: var(--bg);
    border-radius: 6px;
    padding: 6px 12px;
    text-align: center;
    max-width: 80%;
  }
</style>
