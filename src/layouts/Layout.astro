---
/**
 * Shared layout. Head tags via <SEO>, structured data via <Schema>.
 * Organization + WebSite schema ship on every page; pages pass extra schema
 * (Service/FAQPage/Article/…) through the `schema` prop.
 * `bare` strips header/footer for single-goal landing pages (playbook 4.7).
 */
import '@fontsource/inter/400.css';
import '@fontsource/inter/500.css';
import '@fontsource/inter/600.css';
import '@fontsource/inter/700.css';
import '@fontsource/inter/400-italic.css';
import '@fontsource/poppins/500.css';
import '@fontsource/poppins/600.css';
import '@fontsource/poppins/700.css';
import '@fontsource/poppins/800.css';
import '../styles/global.css';

import SEO from '../components/SEO.astro';
import Schema from '../components/Schema.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { organization, website } from '../lib/schema';

interface Props {
  title: string;
  description: string;
  path: string;
  schema?: Record<string, unknown> | Record<string, unknown>[];
  noindex?: boolean;
  bare?: boolean;
  ogType?: 'website' | 'article';
  publishedTime?: string;
  modifiedTime?: string;
}

const { title, description, path, schema, noindex, bare = false, ogType, publishedTime, modifiedTime } = Astro.props;
const extraSchema = schema ? (Array.isArray(schema) ? schema : [schema]) : [];
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="generator" content={Astro.generator} />
    <SEO {title} {description} {path} {noindex} {ogType} {publishedTime} {modifiedTime} />
    <Schema schema={[organization(), website(), ...extraSchema]} />
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    {!bare && <Header />}
    <main id="main">
      <slot />
    </main>
    {!bare && <Footer />}

    <!-- ============================================================
         [ANALYTICS TODO] Event layer stub.
         Swap window.trackEvent's body for the real analytics call
         (e.g. Plausible: window.plausible(name, { props })) once a
         tool is chosen. Events fired:
           cta_click {loc}        — every primary-CTA location
           form_start {form}      — first interaction with any form
           form_submit {form}     — submission
           lead_magnet_download   — micro-conversion (goal)
           call_click             — tel:/booking link clicks (macro goal proxy)
           scroll_depth {pct}     — 25/50/75/100
         ============================================================ -->
    <script>
      type EventProps = Record<string, string | number>;
      const w = window as typeof window & { trackEvent: (n: string, p?: EventProps) => void };
      w.trackEvent = (name, props = {}) => {
        // [ANALYTICS TODO] replace console stub with real provider call
        console.debug('[event]', name, props);
      };

      document.addEventListener('click', (e) => {
        const el = (e.target as HTMLElement).closest<HTMLElement>('[data-event]');
        if (el) w.trackEvent(el.dataset.event!, { loc: el.dataset.eventLoc ?? '' });
        const call = (e.target as HTMLElement).closest<HTMLAnchorElement>('a[href^="tel:"]');
        if (call) w.trackEvent('call_click');
      });

      document.querySelectorAll('form').forEach((form) => {
        const name = form.dataset.form ?? 'form';
        form.addEventListener('focusin', () => w.trackEvent('form_start', { form: name }), { once: true });
        form.addEventListener('submit', () => w.trackEvent('form_submit', { form: name }));
      });

      const marks = [25, 50, 75, 100];
      let fired: number[] = [];
      addEventListener(
        'scroll',
        () => {
          const pct = Math.round(
            ((scrollY + innerHeight) / document.documentElement.scrollHeight) * 100
          );
          marks.forEach((m) => {
            if (pct >= m && !fired.includes(m)) {
              fired.push(m);
              w.trackEvent('scroll_depth', { pct: m });
            }
          });
        },
        { passive: true }
      );
    </script>
  </body>
</html>
