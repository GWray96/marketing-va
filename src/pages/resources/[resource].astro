---
/**
 * Single resource page — name + email gate, then the download.
 * [TODO-HUMAN] real PDFs go in public/downloads/; ESP wiring replaces the stub.
 */
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';

export async function getStaticPaths() {
  const resources = await getCollection('resources');
  return resources.map((r) => ({ params: { resource: r.id }, props: { r } }));
}

const { r } = Astro.props;
const { Content } = await render(r);
const path = `/resources/${r.id}`;
const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Resources', path: '/resources' },
  { name: r.data.title, path },
];
const updated = (r.data.updatedDate ?? new Date()).toLocaleDateString('en-GB', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});
---

<Layout title={`${r.data.title} (Free Download)`} description={r.data.description} path={path}>
  <section class="section">
    <div class="wrap res-grid">
      <div class="res-main">
        <Breadcrumbs crumbs={crumbs} />
        <p class="eyebrow">Free download</p>
        <h1>{r.data.title}</h1>
        <p class="lede">{r.data.description}</p>
        <div class="res-body">
          <Content />
        </div>
        <p class="updated">Last updated: {updated}</p>
      </div>

      <aside class="res-gate card">
        <h2>Get the download</h2>
        <p class="muted">Name and email — that’s it. No sequence-bombing; unsubscribe any time.</p>
        <form class="gate-form" data-form={`resource_${r.id}`} method="post" action="/thanks">
          <label for="g-name">First name</label>
          <input type="text" id="g-name" name="name" required autocomplete="given-name" />
          <label for="g-email">Email</label>
          <input type="email" id="g-email" name="email" required autocomplete="email" inputmode="email" />
          <button type="submit" class="btn">Send it to me</button>
        </form>
      </aside>
    </div>
  </section>
</Layout>

<script>
  // [ESP TODO] Replace stub with real capture + email delivery of the file.
  const form = document.querySelector<HTMLFormElement>('.gate-form');
  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    console.debug('[ESP TODO] resource capture:', Object.fromEntries(new FormData(form).entries()));
    (window as any).trackEvent?.('lead_magnet_download');
    window.location.href = '/thanks';
  });
</script>

<style>
  .res-grid {
    display: grid;
    grid-template-columns: 1.4fr 0.8fr;
    gap: clamp(32px, 5vw, 64px);
    align-items: start;
  }

  .res-main h1 {
    margin-top: 24px;
  }

  .res-body {
    margin-block: 20px;
  }

  .res-gate {
    position: sticky;
    top: 90px;
  }

  .res-gate h2 {
    font-family: var(--font-body);
    font-size: 1.1rem;
    letter-spacing: 0;
  }

  .gate-form label {
    display: block;
    font-weight: 700;
    font-size: 0.88rem;
    margin: 14px 0 6px;
  }

  .gate-form input {
    width: 100%;
    padding: 12px 14px;
    font-family: var(--font-body);
    font-size: 1rem;
    border: 2px solid var(--stone);
    border-radius: var(--radius);
    background: var(--bg);
  }

  .gate-form input:focus {
    border-color: var(--copper-deep);
    outline: none;
  }

  .gate-form .btn {
    margin-top: 18px;
    width: 100%;
    text-align: center;
  }

  @media (max-width: 880px) {
    .res-grid {
      grid-template-columns: 1fr;
    }

    .res-gate {
      position: static;
    }
  }
</style>
