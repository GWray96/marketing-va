---
/**
 * Single case study (playbook 4.4 template): quantified-result headline →
 * situation → problem → what was done → before→after → named quote → CTA.
 * Renders from the `work` content collection; placeholder entries never build.
 */
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CtaBand from '../../components/CtaBand.astro';
import { article } from '../../lib/schema';

export async function getStaticPaths() {
  const cases = await getCollection('work', ({ data }) => !data.placeholder);
  return cases.map((c) => ({ params: { case: c.id }, props: { c } }));
}

const { c } = Astro.props;
const { Content } = await render(c);
const path = `/work/${c.id}`;
const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Work', path: '/work' },
  { name: c.data.client, path },
];
---

<Layout
  title={`${c.data.result} — ${c.data.client} | Marketing Executive VA`}
  description={c.data.title}
  path={path}
  ogType="article"
  schema={[
    article({
      title: c.data.result,
      description: c.data.title,
      path,
      pubDate: new Date(`${c.data.year}-01-01`),
    }),
  ]}
>
  <article class="section">
    <div class="wrap case-wrap">
      <Breadcrumbs crumbs={crumbs} />
      <p class="eyebrow">{c.data.sector} · {c.data.year}</p>
      <h1>{c.data.result}</h1>
      <p class="lede">{c.data.title}</p>

      <div class="case-body">
        <Content />
      </div>

      {c.data.quote && (
        <figure class="case-quote card">
          <blockquote>“{c.data.quote.text}”</blockquote>
          <figcaption>
            <strong>{c.data.quote.name}</strong> — {c.data.quote.role}
          </figcaption>
        </figure>
      )}
    </div>
  </article>

  <CtaBand heading={`Want results like ${c.data.client}?`} loc={`case_${c.id}_final`} />
</Layout>

<style>
  .case-wrap {
    max-width: 800px;
  }

  .case-wrap h1 {
    margin-top: 24px;
  }

  .case-body {
    margin-top: 32px;
  }

  .case-quote {
    margin: 40px 0 0;
  }

  .case-quote blockquote {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.2rem;
    margin: 0 0 14px;
  }
</style>
