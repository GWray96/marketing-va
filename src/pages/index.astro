  <CtaBand loc="home_final" />
</Layout>

<style>
  /* hero — centered stack with floating device below */
  .hero {
    position: relative;
    isolation: isolate;
    overflow: clip; /* crops the bloom like overflow:hidden, but doesn't break sticky children */
    padding-block: clamp(40px, 7vw, 88px);
    text-align: center;
  }

  /* cropped gradient bloom — warm copper with a teal lift, contained to the hero */
  .hero::before {
    content: '';
    position: absolute;
    inset: -10% -5% auto -5%;
    height: 115%;
    z-index: -1;
