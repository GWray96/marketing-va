            <a href={SITE.booking.url} class="btn" data-event="cta_click" data-event-loc={`pricing_${t.name.toLowerCase()}`}>
              {CTA.directShort}
            </a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ FAQ (playbook block 9 — objections at the friction point) ============ -->
  <FaqSection faqs={faqs} />

  <!-- ============ LEAD MAGNET (playbook block 11 — the not-ready-yet) ============ -->
  <section class="section lm-band" aria-label="Free resource">
    <div class="wrap lm-grid">
      <div>
        <p class="eyebrow">Not ready for a call?</p>
        <h2>{SITE.leadMagnet.title}</h2>
        <p class="lede">{SITE.leadMagnet.benefit} Free, and genuinely one page.</p>
