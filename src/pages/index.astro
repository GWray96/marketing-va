  <!-- ============ STAKES (playbook block 12) + FINAL CTA (block 13) ============ -->
  <section class="section stakes">
    <div class="wrap stakes-inner">
      <h2>Half-done marketing doesn’t stand still. It compounds.</h2>
      <p class="lede">
