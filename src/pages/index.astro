      </div>
      <div class="work-grid">
        <div class="work-slot card">
          <p class="slot-tag">[CASE STUDY — collect: first client win with a before→after number, e.g. enquiries/mo, cost per lead, traffic]</p>
        </div>
        <div class="work-slot card">
          <p class="slot-tag">[CASE STUDY — collect: second sector for segmented proof (fit objection — different business type to slot 1)]</p>
        </div>
        <div class="work-slot card">
          <p class="slot-tag">[CASE STUDY — collect: a “felt like hiring a head of marketing” story with named quote + photo]</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ 08 · TESTIMONIALS ============ -->
  <section class="section" id="testimonials">
    <div class="wrap">
      <p class="eyebrow">In their words</p>
      <h2>What working with one person feels like</h2>
      <div class="testi-grid">
        <!-- [TODO-HUMAN] Real testimonials exist — supply name, role, business,
             result + photo for each and they drop straight into these slots. -->
        <Testimonial placeholderNote="TESTIMONIAL — real quote #1: name, role, business, result" />
        <Testimonial placeholderNote="TESTIMONIAL — real quote #2: name, role, business, result" />
        <Testimonial placeholderNote="TESTIMONIAL — real quote #3: name, role, business, result" />
      </div>
    </div>
  </section>

  <!-- ============ 09 · PRICING ============ -->
  <section class="section pricing" id="pricing">
    <div class="wrap">
      <p class="eyebrow">Packages</p>
      <h2>Pick a level. Adjust as you grow.</h2>
      <p class="lede">
