  <script>
    // Hero device: rise + fade out behind the pinned text as you scroll into the hero.
    (() => {
      const hero = document.querySelector('.hero');
      const img = document.querySelector('.hero-img') as HTMLElement | null;
      if (!hero || !img) return;
      const mq = window.matchMedia('(min-width: 768px)');
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');

      let ticking = false;
      const apply = () => {
        ticking = false;
        if (!mq.matches || reduce.matches) {
          img.style.opacity = '';
          img.style.transform = '';
          return;
        }
        // Fade tied to the image's own position: as its top edge rises from
        // ~60% to ~15% of the viewport (sliding up behind the pinned text), it
        // rises a touch faster (parallax) and fades out underneath the text.
        const vh = window.innerHeight;
        const top = img.getBoundingClientRect().top;
        const start = vh * 0.6;
        const end = vh * 0.15;
        const p = Math.min(1, Math.max(0, (start - top) / (start - end)));
        img.style.opacity = String(1 - p);
        img.style.transform = `translateY(${(-p * 8).toFixed(2)}%)`;
      };
      const onScroll = () => {
        if (!ticking) { ticking = true; requestAnimationFrame(apply); }
      };
      window.addEventListener('scroll', onScroll, { passive: true });
      window.addEventListener('resize', onScroll, { passive: true });
      mq.addEventListener('change', apply);
      reduce.addEventListener('change', apply);
      apply();
    })();
  </script>

  <script>
    // Progressive enhancement: the real stats render in static HTML; this only
    // zeroes-then-counts them when the section scrolls into view. If the trigger
    // never fires (or no JS), the correct numbers + filled bar still show.
    (() => {
      const section = document.querySelector('.problem');
      if (!section) return;
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (reduce || !('IntersectionObserver' in window) || !('requestAnimationFrame' in window)) return;

      const nums = section.querySelectorAll('[data-countup]');
      const bar = section.querySelector('.stat-bar-fill') as HTMLElement | null;
      const barTarget = bar ? bar.getAttribute('data-width') : null;

      const animateNum = (el: Element) => {
        const target = parseInt(el.getAttribute('data-countup') || '0', 10);
        const suffix = el.getAttribute('data-suffix') || '';
        const dur = 1100;
        const t0 = performance.now();
        el.textContent = '0' + suffix;
        const tick = (t: number) => {
          const p = Math.min(1, (t - t0) / dur);
          const eased = 1 - Math.pow(1 - p, 3);
          el.textContent = Math.round(target * eased) + suffix;
          if (p < 1) requestAnimationFrame(tick);
        };
        requestAnimationFrame(tick);
      };

      const io = new IntersectionObserver((entries, obs) => {
        entries.forEach((e) => {
          if (!e.isIntersecting) return;
          obs.disconnect();
          nums.forEach(animateNum);
          if (bar && barTarget) {
            bar.style.width = '0%';
            requestAnimationFrame(() => requestAnimationFrame(() => { bar.style.width = barTarget + '%'; }));
          }
        });
      }, { threshold: 0.25 });
      io.observe(section);
    })();
  </script>

  <!-- ============ 02b · TRUST STRIP ============
       Integrity: figures below are the founder's own real, owner-supplied
       results — no client-logo spread until real logos exist (playbook:
       stat beats empty logos). Experience stats live in the About section. -->
