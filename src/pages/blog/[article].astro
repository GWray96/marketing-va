---
/**
 * Article template (playbook 4.8): answer-first opener (in the content),
 * question-shaped H2s, author box (E-E-A-T), internal links UP to the pillar,
 * soft transitional CTA + one direct CTA, FAQ block with schema.
 */
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import FaqSection from '../../components/FaqSection.astro';
import CtaBand from '../../components/CtaBand.astro';
import { SITE, CTA } from '../../config';
import { article as articleSchema } from '../../lib/schema';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((p) => ({ params: { article: p.id }, props: { p } }));
}

const { p } = Astro.props;
const { Content } = await render(p);
const path = `/blog/${p.id}`;
const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Blog', path: '/blog' },
  { name: p.data.title, path },
];
const updated = p.data.updatedDate ?? p.data.pubDate;
const fmt = (d: Date) => d.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
---

<Layout
  title={`${p.data.title} | Marketing Executive VA`}
  description={p.data.description}
  path={path}
  ogType="article"
  publishedTime={p.data.pubDate.toISOString()}
  modifiedTime={updated.toISOString()}
  schema={[
    articleSchema({
      title: p.data.title,
      description: p.data.description,
      path,
      pubDate: p.data.pubDate,
      updatedDate: p.data.updatedDate,
    }),
  ]}
>
  <article class="section">
    <div class="wrap article-wrap">
      <Breadcrumbs crumbs={crumbs} />
      <h1>{p.data.title}</h1>
      <p class="updated">Published {fmt(p.data.pubDate)} · Last updated {fmt(updated)}</p>

      <div class="article-body">
        <Content />
      </div>

      <!-- author box (E-E-A-T) -->
      <aside class="author card">
        <p class="author-name">
          <strong>{SITE.founderName}</strong> · Marketing Executive VA
          <!-- [TODO-HUMAN] real name + small headshot -->
        </p>
        <p class="author-bio">
          I run the whole marketing function for small businesses on a monthly subscription.
          Before that: a year on eBay’s Start Up–Scale Up programme, speaking with thousands of
          UK business owners about their marketing. <a href="/about">More about me</a>.
        </p>
      </aside>

      <!-- soft transitional CTA -->
      <div class="article-cta">
        <p>
          Doing this yourself? <a href={`/${SITE.leadMagnet.slug}`}>{SITE.leadMagnet.title}</a> condenses
          it to one page. Rather have it handled? <a href={SITE.booking.url}>{CTA.direct}</a>.
        </p>
      </div>
    </div>
  </article>

  {p.data.faqs.length > 0 && <FaqSection faqs={p.data.faqs} heading="Related questions" />}

  <CtaBand loc={`article_${p.id}_final`} />
</Layout>

<style>
  .article-wrap {
    max-width: 760px;
  }

  .article-wrap h1 {
    margin-top: 24px;
  }

  .article-body {
    margin-top: 28px;
  }

  .article-body :global(h2) {
    margin-top: 40px;
    font-size: 1.45rem;
  }

  .article-body :global(h3) {
    margin-top: 28px;
  }

  .article-body :global(table) {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.93rem;
    margin-block: 20px;
  }

  .article-body :global(th),
  .article-body :global(td) {
    border: 1px solid var(--tint);
    padding: 10px 12px;
    text-align: left;
    vertical-align: top;
  }

  .article-body :global(thead th) {
    background: var(--tint);
  }

  .article-body :global(blockquote) {
    border-left: 4px solid var(--copper);
    margin: 20px 0;
    padding: 4px 0 4px 20px;
    font-style: italic;
  }

  .author {
    margin-top: 44px;
  }

  .author-name {
    margin-bottom: 6px;
  }

  .author-bio {
    font-size: 0.92rem;
    color: var(--stone);
    margin: 0;
  }

  .article-cta {
    margin-top: 24px;
    padding: 20px 24px;
    background: var(--tint);
    border-radius: var(--radius);
  }

  .article-cta p {
    margin: 0;
  }
</style>
